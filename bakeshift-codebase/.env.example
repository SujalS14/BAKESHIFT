# ==============================================================
# BAKESHIFT — STRIPE SANDBOX CONFIGURATION (TEST MODE ONLY)
# ==============================================================
# IMPORTANT: Use Stripe TEST credentials ONLY. Live keys (sk_live_*)
# are strictly blocked by the server security validation barrier.
#
# Obtain your test keys from: https://dashboard.stripe.com/test/apikeys
# Create a test Price ID at: https://dashboard.stripe.com/test/products
# ==============================================================

# Stripe Sandbox Secret Key (server-side only, begins with sk_test_)
STRIPE_SECRET_KEY=sk_test_placeholder_key_here

# Stripe Sandbox Publishable Key (client-side, begins with pk_test_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_here

# Optional: Stripe Price ID for BAKESHIFT Complete Baking System ($55.00 USD)
# If left blank, server dynamically uses Stripe standard price_data ($55.00 USD unit amount).
STRIPE_PRICE_ID=
